{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription data",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "discordId": { "type": "string", "description": "Discord User ID linked to the account" },
        "plan": { "type": "string", "enum": ["aio", "single", "none"] },
        "accountStatus": { "type": "string", "enum": ["active", "inactive", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "entitlements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of purchased rotation IDs"
        }
      },
      "required": ["email", "plan", "accountStatus", "createdAt", "updatedAt", "role"]
    },
    "CDKey": {
      "title": "CDKey",
      "description": "License key for the software",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "unused", "revoked"] },
        "plan": { "type": "string", "enum": ["aio", "single"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "status", "plan", "createdAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Historical record of payments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "plan": { "type": "string", "enum": ["aio", "single"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "plan", "amount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/cd_keys/{keyId}": {
      "schema": "CDKey",
      "description": "License keys"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Payment records"
    }
  }
}
