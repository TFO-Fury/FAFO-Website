# Environment Variables Template
# Copy this to .env and fill in the values

# Firebase Configuration (Automatically handled by AI Studio)
# FIREBASE_PROJECT_ID=

# Discord OAuth Configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_AIO=
DISCORD_ROLE_ONE_CLASS=
DISCORD_ROLE_TRIAL=

# Application URL (Optional, will be auto-detected if not set)
# APP_URL=https://faforotations.shop

# GitHub Integration (Required for license sync + download proxy)
# Must have repo access to read private releases
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_FILE_PATH=
