rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let reqAuth = request.auth;
      let email = reqAuth.token.get('email', '').lower();
      let isOwnerEmail = isSignedIn() && (email == 'nick9284@gmail.com');
      return isOwnerEmail || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(reqAuth.uid)) && 
        get(/databases/$(database)/documents/users/$(reqAuth.uid)).data.get('isAdmin', false) == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      let email = data.get('email', '');
      let plan = data.get('plan', 'none');
      let status = data.get('accountStatus', 'inactive');
      
      return email is string && email.size() <= 100 &&
             plan in ['aio', 'single', 'none', 'trial'] &&
             status in ['active', 'inactive', 'expired'] &&
             (data.get('discordId', null) == null || (data.discordId is string && data.discordId.size() <= 128)) &&
             (data.get('isAdmin', false) is bool) &&
             (data.get('trialUsed', false) is bool);
    }

    function isValidUserCreate(data) {
      return isValidUser(data) && data.get('isAdmin', false) == false;
    }

    // Collection Security
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidUserCreate(request.resource.data);

      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          // Owner can update their own profile fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discordId', 'plan', 'accountStatus', 'updatedAt', 'trialUsed', 'email', 'photoURL', 'uid', 'isAdmin']) &&
          // Protect admin status
          (request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)) &&
          isValidUser(request.resource.data)
        )
      );
    }

    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
