rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Safe check for isAdmin field on the user's document
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let isExplicitAdmin = isSignedIn() && user != null && user.data.get('isAdmin', false) == true;
      let isOwnerEmail = isSignedIn() && request.auth.token.get('email', '') == 'Nick9284@gmail.com' && request.auth.token.email_verified == true;
      return isExplicitAdmin || isOwnerEmail;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.get('email', '') is string &&
             data.plan in ['aio', 'single', 'none', 'trial'] &&
             data.accountStatus in ['active', 'inactive', 'expired'] &&
             (data.discordId == null || (data.discordId is string && data.discordId.size() <= 128)) &&
             (data.isAdmin == null || data.isAdmin is bool) &&
             (data.trialUsed == null || data.trialUsed is bool);
    }

    // Collection Security
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId);

      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          // Owner can update their own profile fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discordId', 'plan', 'accountStatus', 'updatedAt', 'trialUsed']) &&
          // Cannot unset trialUsed once true
          (resource.data.get('trialUsed', false) == false || request.resource.data.trialUsed == true) &&
          isValidUser(request.resource.data)
        )
      );
    }

    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
