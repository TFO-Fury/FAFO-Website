rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let reqAuth = request.auth;
      let email = reqAuth.token.get('email', '').lower();
      let isOwnerEmail = isSignedIn() && (email == 'nick9284@gmail.com');
      return isOwnerEmail || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(reqAuth.uid)) && 
        get(/databases/$(database)/documents/users/$(reqAuth.uid)).data.get('role', 'user') == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      let email = data.get('email', '');
      let plan = data.get('plan', 'none');
      let status = data.get('accountStatus', 'inactive');
      let role = data.get('role', 'user');
      
      return email is string && email.size() <= 100 &&
             plan in ['aio', 'single', 'none', 'trial'] &&
             status in ['active', 'inactive', 'expired'] &&
             role in ['user', 'admin'] &&
             (data.get('discordId', null) == null || (data.discordId is string && data.discordId.size() <= 128)) &&
             (data.get('trialUsed', false) is bool) &&
             (data.get('entitlements', []) is list) &&
             (data.get('expiresAt', null) == null || data.expiresAt is timestamp);
    }

    function isValidUserCreate(data) {
      return isValidUser(data) && data.get('role', 'user') == 'user';
    }

    function isValidCDKey(data) {
      return data.key is string &&
             data.status in ['active', 'unused', 'revoked'] &&
             data.plan in ['aio', 'single'] &&
             (data.get('userId', null) == null || data.userId is string) &&
             data.createdAt is timestamp;
    }

    // Collection Security
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && isOwner(userId) && isValidUserCreate(request.resource.data);

      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          // Owner can update their own profile fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discordId', 'plan', 'accountStatus', 'updatedAt', 'trialUsed', 'email', 'photoURL', 'uid', 'role', 'entitlements', 'expiresAt']) &&
          // Protect role and entitlements and expiresAt (owners can't escalate themselves)
          (request.resource.data.get('role', 'user') == resource.data.get('role', 'user')) &&
          (request.resource.data.get('entitlements', []) == resource.data.get('entitlements', [])) &&
          (request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null)) &&
          isValidUser(request.resource.data)
        )
      );
    }

    match /cd_keys/{keyId} {
      allow get: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/cd_keys/$(keyId)) && get(/databases/$(database)/documents/cd_keys/$(keyId)).data.userId == request.auth.uid);
      allow list: if isAdmin();
      // Writing to CD Keys is strictly Admin or Backend (via Admin SDK)
      allow create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
